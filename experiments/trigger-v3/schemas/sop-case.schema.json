{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/newlys/TencentDB-Agent-Memory/experiments/trigger-v3/schemas/sop-case.schema.json",
  "title": "Trigger v3 independent SOP case",
  "type": "object",
  "required": ["case_id", "family_id", "domain", "sequence_no", "messages", "source_provenance", "environment", "execution_evidence", "terminal_verification", "boundary_gold", "action_gold", "skill_after", "action_reason", "safety_and_rollback", "split"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9-]+--[0-9]{2}$" },
    "family_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "sequence_no": { "type": "integer", "minimum": 1, "maximum": 10 },
    "action_gold": { "enum": ["create", "update", "nothing"] },
    "split": { "enum": ["calibration", "development", "final_test"] },
    "messages": { "type": "array", "minItems": 10, "items": { "type": "object", "required": ["role", "content"], "properties": { "role": { "enum": ["user", "assistant", "tool_call", "tool_result"] }, "content": { "type": "string", "minLength": 1 } } } },
    "boundary_gold": { "type": "object", "required": ["should_trigger", "cut_after_message"], "properties": { "should_trigger": { "const": true }, "cut_after_message": { "type": "integer", "minimum": 1 } } }
  }
}
